{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fractal-works/autorouter-models/schema.json",
  "title": "AutoRouter models",
  "type": "object",
  "required": ["description", "units", "sources", "subscriptionValue", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "units": { "type": "object", "additionalProperties": { "type": "string" } },
    "subscriptionValue": {
      "type": "object",
      "required": ["measured", "workload", "note"],
      "additionalProperties": false,
      "properties": {
        "measured": { "type": "string", "format": "date" },
        "workload": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id", "name", "vendor", "maker", "role", "contextWindow", "maxOutput", "modalities", "price", "subscription"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9][a-z0-9.-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "maker": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "contextWindow": { "type": ["integer", "null"], "minimum": 1 },
        "maxOutput": { "type": ["integer", "null"], "minimum": 1 },
        "modalities": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["input", "output"],
              "additionalProperties": false,
              "properties": {
                "input": { "type": "array", "items": { "type": "string" } },
                "output": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "price": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["input", "cachedInput", "output", "source", "checked"],
              "additionalProperties": false,
              "properties": {
                "input": { "$ref": "#/$defs/usd" },
                "cachedInput": { "$ref": "#/$defs/usd" },
                "output": { "$ref": "#/$defs/usd" },
                "longContext": {
                  "type": "object",
                  "required": ["above", "input", "cachedInput", "output"],
                  "additionalProperties": false,
                  "properties": {
                    "above": { "type": "integer", "minimum": 1 },
                    "input": { "$ref": "#/$defs/usd" },
                    "cachedInput": { "$ref": "#/$defs/usd" },
                    "output": { "$ref": "#/$defs/usd" }
                  }
                },
                "source": { "type": "string", "format": "uri" },
                "checked": { "type": ["string", "null"], "format": "date" }
              }
            }
          ]
        },
        "subscription": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["multiple", "measured", "plans", "allowanceCap", "input", "cachedInput", "output"],
              "additionalProperties": false,
              "properties": {
                "multiple": { "type": "number", "exclusiveMinimum": 1 },
                "measured": { "type": "boolean" },
                "plans": { "type": ["array", "null"], "items": { "type": "string" } },
                "allowanceCap": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                "input": { "$ref": "#/$defs/usd" },
                "cachedInput": { "$ref": "#/$defs/usd" },
                "output": { "$ref": "#/$defs/usd" }
              }
            }
          ]
        }
      }
    },
    "usd": { "type": "number", "exclusiveMinimum": 0 }
  }
}
